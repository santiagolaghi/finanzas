{
  "name": "Finanzas Pro",
  "short_name": "Finanzas Pro",
  "description": "Finanzas personales simples, visuales y conectadas, con Voice y Capture.",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f5f9",
  "theme_color": "#6d4de3",
  "lang": "es-AR",
  "orientation": "any",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Anotar por voz",
      "short_name": "Voz",
      "description": "Dict\u00e1 una frase, revis\u00e1 y guard\u00e1 el movimiento.",
      "url": "./#/voz?auto=1",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Capturar comprobante",
      "short_name": "Capture",
      "description": "Abrir c\u00e1mara/archivo para preparar un movimiento.",
      "url": "./#/capturar",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nuevo movimiento",
      "short_name": "Nuevo",
      "url": "./#/movimientos?nuevo=1",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Abrir Billetera",
      "short_name": "Billetera",
      "url": "./#/billetera",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "id": "./",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf"
          ]
        }
      ]
    }
  }
}
